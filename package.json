{
  "name": "together-mcp",
  "version": "0.1.8",
  "description": "Image Generation MCP Server using Together.AI - A Model Context Protocol server for AI image generation",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "together-mcp": "build/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/manascb1344/together-mcp-server"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "image-generation",
    "together-ai"
  ],
  "author": "Model Context Protocol",
  "license": "MIT",
  "files": [
    "build",
    "build/index.js"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "0.6.0",
    "axios": "^1.11.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.9",
    "jest": "^30.5.2",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "dev": "tsc --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "inspector": "pnpm dlx @modelcontextprotocol/inspector build/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  }
}
